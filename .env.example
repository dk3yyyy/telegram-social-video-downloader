# Copy to .env and replace every placeholder.
# Generate a strong API key, for example: openssl rand -hex 32
DOWNLOADER_API_KEY=replace-with-at-least-24-random-characters
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
DATABASE_PATH=/data/jobs.sqlite3
MAX_WORKERS=2
MAX_QUEUE_SIZE=100
JOB_TIMEOUT_SECONDS=600
MAX_DOWNLOAD_MIB=256
MAX_DURATION_SECONDS=1800
JOB_RETENTION_DAYS=7
AUTOMATION_NETWORK=automation
